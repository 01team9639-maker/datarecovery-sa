Options -Indexes
ServerSignature Off

# ============================================================================
# DEPLOYMENT CHECK — read this before debugging any rule below.
#
# On 2026-08-11 the live site at datarecovery-sa.com was serving:
#   /ar/       -> 404   (the redirect below should have caught it)
#   /.user.ini -> 200   (the FilesMatch below should have denied it)
#   response headers carried NONE of the security headers set here.
#
# All three symptoms together mean this file was not in effect on the server at
# all — not that a single rule is wrong. Either .htaccess was never uploaded
# (many FTP clients and zip extractors skip dotfiles), or AllowOverride is off
# for the document root. Verify with hPanel's file manager (enable "show hidden
# files") and re-upload from dist/hostinger/ before assuming a rule is broken.
# ============================================================================

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # GTM Preview — يضبط Z2O_GTM_PREVIEW لترويسات المعاينة المحدودة (انظر كتلة
  # «GTM Preview» فوق الترويسات). أول قاعدة عمدًا: بلا [L]، فلا تُوقف ما بعدها،
  # ولا تسبقها قاعدة [L] تمنع ضبط المتغيّر. ومكرَّرة في ‎/blog/.htaccess‎
  # و‎/blog/en/.htaccess‎ لأن RewriteEngine On هناك يُصفّر ما هنا.
  RewriteCond %{QUERY_STRING} (^|&)gtm_debug= [OR]
  RewriteCond %{HTTP_COOKIE} (^|;)\s*_{1,2}TAG_ASSISTANT=
  RewriteRule ^ - [E=Z2O_GTM_PREVIEW:1]

  # ---- Canonical host -------------------------------------------------------
  # www served the entire site with 200 — every page, and every CSS and image
  # file, existed at two live addresses. Measured 2026-09-05 across nine paths:
  # only /blog/ redirected, because it ships its own .htaccess whose
  # `RewriteEngine On` resets rewrite inheritance.
  #
  # This runs FIRST, ahead of the existing-file passthrough further down. Put
  # after it, a request for www/assets/css/main.min.css would match a real file
  # and be served from the wrong host instead of redirected.
  #
  # $1 carries the path and [QSA] carries the query string, so
  # www/services/hdd.html?source=google&id=5 keeps both. [NE] leaves already
  # encoded characters alone — the Arabic legacy rules below rely on that.
  #
  # NOTE — one hop for https://www, two for http://www. Hostinger upgrades HTTP
  # to HTTPS at its own edge before Apache sees the request, so this rule can
  # only ever fire on the second leg. Collapsing that pair into one hop needs
  # the www redirect set at the hosting layer, which is the owner's panel.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L,NE,QSA]

  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [R=404,L,NC]
  RewriteRule ^(?:build|design|tests)(?:/|$) - [R=404,L,NC]

  # ---- Legacy URL map -------------------------------------------------------
  # Every rule here converts an old inbound link into a live page instead of a
  # 404. Blanket-redirecting unknown paths to the homepage is deliberately NOT
  # done: Google treats that as a soft 404 and it loses the same link equity as
  # the 404 did, while also hiding the problem from Search Console.

  # 410 Gone, not 404, for pages the old site had and this one deliberately does
  # not. Both remove the URL, but 410 states the removal is permanent, and Google
  # retires a 410 faster than a 404 — which it re-crawls for a while in case the
  # page returns. Used only where a real equivalent does not exist; where one
  # does, the 301 above is the better answer.
  RewriteRule ^wp-(content|admin|includes|json)(/|$) - [G,L]
  RewriteRule ^our-team/?$ - [G,L]
  RewriteRule ^secure-data-destruction-services/?$ - [G,L]
  RewriteRule ^20(2[0-9])/?$ - [G,L]

  # Two legacy paths the 2026-08-20 audit found still live in Google's index.
  # /services/ answered 403 — a directory with no index and listing denied. To a
  # crawler a 403 reads as "temporarily withheld", so it keeps the old URL rather
  # than following it onward. A 404 would at least retire it; a 301 to the real
  # section retires it AND passes the link equity on.
  RewriteRule ^services/?$ /#services [R=301,L]
  RewriteRule ^contacts/?$ /contact.html [R=301,L]

  # صفحة خدمة الفدية القديمة ← بوابة القسم /ransomware/ (التكليف الموحّد §11.2).
  # ما بين العلامتين يكتبه build/generate.js بحسب ransomwareSection، ومعه يبدّل
  # وجهة كل قاعدة قديمة أدناه كانت تذهب إلى /services/ransomware.html — كي لا
  # يمرّ زائر رابط قديم بقفزتين.
  # z2o:ransomware-redirect BEGIN
  # يولّده build/generate.js من ransomwareSection — لا تحرّره يدويًّا.
  # قفزة واحدة إلى البوابة بلا سلسلة: بامتداد وبلاه وبشرطة مائلة. والمسار
  # /services/ransomware/ نفسه مجلد الحالات بلا فهرس (403)، فيُحوَّل كذلك.
  # أما /services/ransomware/cases/… فخارج النمط عمدًا: الحالات تبقى في عناوينها.
  RewriteRule ^services/ransomware(?:\.html?|/)?$ /ransomware/ [R=301,L,NC]
  RewriteRule ^en/services/ransomware(?:\.html?|/)?$ /en/ransomware/ [R=301,L,NC]
  # صفحات القسم مجلدات بفهرس: /ransomware/index.html نسخة ثانية للعنوان نفسه.
  RewriteRule ^((?:en/)?ransomware/(?:[a-z-]+/)?)index\.html?$ /$1 [R=301,L,NC]
  # عنوان غير موجود داخل القسم الجديد يبقى 404 صريحًا: لا روابط قديمة تحته،
  # وخريطة الكلمات في الأسفل كانت ستحوّل كل خطأ كتابة إلى البوابة (soft 404).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(?:en/)?ransomware/. - [R=404,L]
  # z2o:ransomware-redirect END

# Articles retired 2026-08-25 in favour of /blog/. The five pieces were indexed,
# so the old URLs redirect instead of 404ing; /blog/ carries different posts, so
# they land on the blog index rather than pretending to be the same article.
RewriteRule ^en/articles(/.*)?$ /blog/en/ [R=301,L]
RewriteRule ^articles(/.*)?$ /blog/ [R=301,L]

  # ORDER MATTERS. The Arabic-slug pages from the old Osool site must be matched
  # BEFORE the generic /ar/ prefix strip below, because that strip is [L]: it
  # would rewrite /ar/raid-… to /raid-…, stop, and hand the visitor a second 404.
  # Verified against a local Apache with AllowOverride All — with these two rules
  # placed after the strip, both confirmed legacy URLs still died.
  # Arabic is written literally, NOT percent-encoded. Verified on Apache 2.4:
  # in .htaccess context RewriteRule matches the DECODED path, and %{REQUEST_URI}
  # is decoded too — a %D9%87%D8%A7... pattern silently never matches.
  RewriteRule ^ar/raid- /services/raid-servers.html [R=301,L,NC]
  RewriteRule ^ar/.*(هارد|قرص.صلب) /services/hdd.html [R=301,L]
  RewriteRule ^ar/.*(فدية|تشفير) /ransomware/ [R=301,L]
  RewriteRule ^ar/.*(سيرفر|خادم|قاعدة.بيانات) /services/raid-servers.html [R=301,L]
  RewriteRule ^ar/.*(جوال|هاتف|موبايل) /services/phones.html [R=301,L]
  RewriteRule ^ar/.*(كاميرا|مراقبة) /services/cctv.html [R=301,L]
  RewriteRule ^ar/.*(فورمات|تهيئة) /services/after-format.html [R=301,L]
  RewriteRule ^ar/.*(فلاش|ذاكرة|بطاقة) /services/memory-cards.html [R=301,L]
  # النسخ الاحتياطي: لا صفحة خدمة له — الموقع يعالجه وقايةً لا استعادةً —
  # ووجهته الصحيحة مقال المدونة الذي يشرح قاعدة 3-2-1 وكيفية اختبارها.
  # بلا هذه القاعدة يسقط الرابط إلى تجريد /ar/ العام فينتهي 404، وهو ما رصده
  # تدقيق 2026-09-16 على /ar/حلول-النسخ-الاحتياطي-للبيانات/.
  RewriteRule ^ar/.*(احتياطي|احتياطية|باك.?اب) /blog/backup-3-2-1-rule/ [R=301,L]

  # الأشرطة المغناطيسية ومحركات الأقراص: كانتا تسقطان إلى تجريد /ar/ العام
  # ثم تلتقطهما قاعدة شاملة في الأسفل فتصلان في قفزتين إلى وجهة واحدة —
  # والأشرطة ليست قرصًا صلبًا. التقاطهما هنا يجعلها قفزة واحدة إلى الوجهة
  # الصحيحة لكلٍّ. رصدهما تدقيق 2026-09-16.
  RewriteRule ^ar/.*(شريط|أشرطة|الأشرطة|مغناطيسي) /#services [R=301,L,NE]
  RewriteRule ^ar/.*(محرك|محركات|الأقراص|اسطوانة) /services/hdd.html [R=301,L]

  # المدن بعد الخدمات لا قبلها: «استعادة هارد في الرياض» مشكلتُها القرص لا
  # المدينة، فصفحة الخدمة أدقّ. وما لا يذكر خدمةً بعينها تكفيه صفحة مدينته.
  RewriteRule ^ar/.*(الرياض) /cities/riyadh.html [R=301,L]
  RewriteRule ^ar/.*(جدة|جده) /cities/jeddah.html [R=301,L]
  RewriteRule ^ar/.*(الدمام|دمام) /cities/dammam.html [R=301,L]

  # «استعادة البيانات» وحدها بلا وسيط: اسم النشاط كلّه. وجهتها الرئيسية —
  # الصفحة التي تتحدّث عن ذلك فعلًا — لا صفحة قرص صلب لا يملكه الزائر، ولا
  # 404. هذه آخر قاعدة موضوعية: ما بلغها لم تلتقطه خدمة ولا مدينة.
  RewriteRule ^ar/.*(استعادة|استرجاع|بيانات|data.recovery) / [R=301,L,NE]

  # ما بقي: أسقِط البادئة. وإن كان له ملف .html فاذهب إليه مباشرةً — بلا هذا
  # الشرط يمرّ /ar/about بقفزتين: /about ثم /about.html.
  RewriteRule ^ar/index\.(?:html?|php)$ / [R=301,L,NC]
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^ar/(.+?)/?$ /$1.html [R=301,L]
  RewriteRule ^ar/(.*)$ /$1 [R=301,L]
  RewriteRule ^ar$ / [R=301,L]

  # Directory-index and extension leftovers from the previous site.
  RewriteRule ^index\.(?:html?|php)$ / [R=301,L,NC]
  RewriteRule ^en/index\.(?:html?|php)$ /en/ [R=301,L,NC]
  RewriteRule ^contact\.php$ /contact.html [R=301,L,NC]
  RewriteRule ^en/contact\.php$ /en/contact.html [R=301,L,NC]

  # Extensionless requests (/services/hdd) and trailing-slash ones (/about/)
  # resolve to the .html file when one exists. Old sites commonly published
  # these; costs nothing to keep working.
  #
  # 301, not an internal rewrite: the rewrite served the same page under two
  # live addresses — /about/ answered 200 under its own URL while declaring
  # canonical /about.html. A canonical is a hint; a 301 is an instruction, and
  # it consolidates whatever links the old site left pointing at these forms.
  # Internal navigation and the sitemap use .html everywhere, so nothing on the
  # site takes the extra hop — only a visitor arriving on a legacy address does.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ /$1.html [R=301,L]

  # Old database-repair page: no equivalent service page exists on this site, and
  # ransomware is where SQL/MDF recovery is actually described.
  RewriteRule ^sql-data-base-repair/?$ /ransomware/ [R=301,L,NC]

  # المتصفّحات تطلب /favicon.ico من الجذر تلقائيًّا ولو أعلنت الصفحة أيقوناتها
  # صراحةً — وهو طلب لا يُلغى. بلا هذه القاعدة يظهر 404 في طرفية كل زائر
  # ويخصم من «أفضليات» Lighthouse. تحويل إلى الأيقونة الموجودة أنظف من نسخة
  # ثانية من الملف في الجذر.
  RewriteRule ^favicon\.ico$ /assets/favicon-48.png [R=301,L,NC]

  # ---- Legacy Osool URLs ----------------------------------------------------
  # No Search Console export was available, so these were recovered from Google's
  # live index on 2026-08-12. Two distinct structures survive from the old site:
  #   /ar/<arabic-slug>/            Arabic service + article pages
  #   /<english-slug>/              English service pages at the root
  # Confirmed still indexed and returning 404:
  #   /ar/raid-استعادة-البيانات-من-أنظمة/
  #   /ar/كيف-تستعيد-بياناتك-من-قرص-صلب-هارد-ديسك/
  #   /hard-drive-data-recovery/
  #   /solid-state-drive-data-recovery-services/
  #
  # The two Arabic ones are handled at the top of this block, ahead of the /ar/
  # prefix strip — see the ORDER MATTERS note there.

  # Nothing here may shadow a real page, so every rule is guarded on the request
  # not matching an existing file or directory. That also makes the keyword rules
  # safe to keep permanently: they can only ever fire on a URL that would 404.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /blog/ belongs to the separate Hugo blog and is off-limits to the keyword map
  # below. Without this, a blog URL that happens to contain a service word — say
  # /blog/what-is-raid/ — would be 301'd to the RAID service page instead of
  # reaching the article, and a mistyped blog URL would skip the blog's own 404.
  # The blog ships its own /blog/.htaccess whose `RewriteEngine On` already
  # resets rewrite inheritance, so this is belt and braces; it is cheap, and it
  # keeps the boundary visible to whoever reads this file next.
  RewriteRule ^blog(/|$) - [L]

  # Keyword map over the whole legacy URL space. The old slugs are unknown in
  # full, so these match on the terms any data-recovery slug would contain, in
  # either language, and land the visitor on the page for the problem they had.
  RewriteRule (ransomware|فدية|تشفير) /ransomware/ [R=301,L,NC]
  RewriteRule (raid|server|nas|san|database) /services/raid-servers.html [R=301,L,NC]
  RewriteRule (solid[-_]?state|ssd|nvme|m\.?2) /services/ssd-nvme.html [R=301,L,NC]
  RewriteRule (cctv|dvr|nvr|surveillance|camera) /services/cctv.html [R=301,L,NC]
  RewriteRule (format|deleted|erase|disposal) /services/after-format.html [R=301,L,NC]
  RewriteRule (flash|memory[-_]?card|usb|sd[-_]?card|micro-?sd) /services/memory-cards.html [R=301,L,NC]
  RewriteRule (mobile|phone|android|iphone|smartphone) /services/phones.html [R=301,L,NC]
  # الأشرطة المغناطيسية قبل قاعدة القرص: كلمة «شريط» موضوع مستقلّ، وسقوطها
  # إلى HDD يُرضي فحص 200 ويُخيّب القارئ. لا صفحة خدمة للأشرطة، ووجهتها صفحة
  # الخدمات حيث يختار بنفسه — لا تخمينًا باسم قرص لا يملكه.
  RewriteRule (tape|lto|شريط|أشرطة|الأشرطة|مغناطيسي) /#services [R=301,L,NC,NE]

  RewriteRule (hard[-_]?drive|hard[-_]?disk|hdd|disk|drive) /services/hdd.html [R=301,L,NC]

  # «استعادة» و«recovery» اسم النشاط كلّه لا اسم خدمة بعينها، فكل رابط عربي
  # فيه الكلمة كان يسقط إلى HDD مهما كان موضوعه — وهو ما رصده تدقيق 09-16 على
  # روابط الأشرطة المغناطيسية. حُذفت من خريطة الخدمات: ما لم تلتقطه القواعد
  # الموضوعية أعلاه يصل إلى 404 الذي يسرد الخدمات كلها، فيختار القارئ.
  #
  # وبقيت backup وحدها موجَّهةً إلى مقال النسخ الاحتياطي لا إلى HDD: لها
  # موضوع محدَّد في الموقع، والمقال يعالجه.
  RewriteRule (backup|back[-_]?up) /blog/backup-3-2-1-rule/ [R=301,L,NC]

  # المدن بعد الخدمات: الخدمة تصف المشكلة، والمدينة تصف مكانها فقط.
  RewriteRule (riyadh|الرياض) /cities/riyadh.html [R=301,L,NC]
  RewriteRule (jeddah|جدة|جده) /cities/jeddah.html [R=301,L,NC]
  RewriteRule (dammam|الدمام|دمام) /cities/dammam.html [R=301,L,NC]

  # وأخيرًا الاسم العامّ للنشاط. حذفُه بالكامل — كما فعلتُ أولًا — أصلح
  # الأشرطة وأسقط أعمّ الروابط القديمة إلى 404: /data-recovery/ نفسه.
  # مكانه الصحيح آخر القائمة لا وسطها: لا يلتقط إلا ما لم تُطالب به خدمة
  # ولا مدينة، ووجهته الرئيسية.
  RewriteRule (data[-_]?recovery|recovery|restore|استعادة|استرجاع) / [R=301,L,NC,NE]

  # Anything still unmatched falls through to ErrorDocument 404, which serves a
  # page listing every service — deliberately NOT a blanket redirect to the
  # homepage, which Google treats as a soft 404 and which loses the same link
  # equity while hiding the problem from Search Console.
  # ---------------------------------------------------------------------------
</IfModule>

<FilesMatch "^(?:README\.md|LIBRARIES\.md|test-form\.command|netlify\.toml|\.user\.ini|\.mcp\.json|\.DS_Store)$">
  Require all denied
</FilesMatch>

# Cache lifetimes — mirrors netlify.toml. Every first-party CSS/JS URL carries a
# content hash (`?v=`), so a changed file is a new URL and the old one can be
# held for a year. Vendor bundles are exempt: they ship unversioned upstream, so
# they keep revalidating daily.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/assets/js/vendor/" Z2O_VENDOR=1
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Cache-Control "public, max-age=86400, must-revalidate" env=Z2O_VENDOR
  </FilesMatch>
  <FilesMatch "\.(png|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- GTM Preview (Tag Assistant): استثناء محدود -----------------------------
# Tag Assistant يفتح الموقع في نافذة من tagassistant.google.com ويتّصل بها عبر
# window.opener. و COOP: same-origin يقطع هذا المرجع لأي فاتحٍ من أصل آخر —
# فترى نافذة Tag Assistant الموقع «مغلقًا» فورًا: «The window was closed before
# a connection could be established». same-origin-allow-popups لا يحلّها: يحمي
# من فتحه الموقع لا من فتح الموقع. unsafe-none وحدها تُبقي المرجع (MDN، جدول
# Opening with Window.open). ثبت على الإنتاج 2026-09-17: popup.closed=true
# و window.opener=null.
#
# ووضع المعاينة يحمّل من Google ملفات لا تحتاجها الصفحة العادية (قائمة وثائق
# Google «Use a Content Security Policy»: tagmanager.google.com وbadge.css
# وخطوط fonts.googleapis/gstatic وصور gstatic)، ويكتب أنماطًا مضمّنة لشارة
# المعاينة — رُصدت كلها محجوبة في Console. وأيقونات الشارة صور PNG من
# fonts.gstatic.com، خارج قائمة Google لـimg-src — رُصدت في جلسة Tag Assistant
# حقيقية 2026-09-17 فأُضيفت. 'unsafe-inline' هنا للأنماط وحدها،
# لا للسكربتات، ولا يُضاف unsafe-eval ولا *.
#
# الاستثناء لا يُفعَّل إلا بإشارتَي Google نفسيهما:
#   ‎?gtm_debug=‎ في الرابط — تضعه Tag Assistant في أول صفحة تفتحها؛
#   كوكي ‎_TAG_ASSISTANT / __TAG_ASSISTANT‎ — تكتبه GTM على النطاق لتبقى
#   المعاينة متّصلة حين تتنقّل بين الصفحات.
# أي زائر بلا هاتين الإشارتين يأخذ الترويسات الصارمة كما هي.
#
# المتغيّر يُضبط بـRewriteCond/[E=] في أول كتلة إعادة الكتابة، لا بـSetEnvIfExpr:
# جُرّب أولًا (2c32153) فعمل على Apache 2.4.66 محلّيًّا وتجاهله خادم Hostinger
# (LiteSpeed) بصمت — بقيت الترويسات صارمة مع ‎?gtm_debug=‎. و[E=] مدعوم في الاثنين.
<IfModule mod_headers.c>
  Header always unset Server
  # الترويسة العادية لكل زائر، والنسخة الموسَّعة لجلسات معاينة GTM وحدها.
  # الشرط Z2O_GTM_PREVIEW يُضبط أدناه من إشارتَي Google نفسيهما — انظر كتلة
  # «GTM Preview» تحت الترويسات.
  Header always set Content-Security-Policy "default-src 'none'; base-uri 'none'; connect-src 'self' https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://*.doubleclick.net https://www.google.com https://www.googleadservices.com; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src https://www.googletagmanager.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.doubleclick.net https://www.google.com https://www.google.com.sa https://www.google.ae https://www.google.com.kw https://www.google.com.qa https://www.google.com.bh https://www.google.com.om https://www.google.com.eg https://www.google.jo https://www.google.com.lb https://www.google.nl; manifest-src 'self'; media-src 'none'; object-src 'none'; script-src 'self' https://www.googletagmanager.com https://www.clarity.ms https://www.googleadservices.com https://googleads.g.doubleclick.net; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; worker-src 'none'; upgrade-insecure-requests" env=!Z2O_GTM_PREVIEW
  Header always set Content-Security-Policy "default-src 'none'; base-uri 'none'; connect-src 'self' https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://*.doubleclick.net https://www.google.com https://www.googleadservices.com; font-src 'self' https://fonts.gstatic.com data:; form-action 'self'; frame-ancestors 'none'; frame-src https://www.googletagmanager.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.doubleclick.net https://www.google.com https://www.google.com.sa https://www.google.ae https://www.google.com.kw https://www.google.com.qa https://www.google.com.bh https://www.google.com.om https://www.google.com.eg https://www.google.jo https://www.google.com.lb https://www.google.nl https://ssl.gstatic.com https://www.gstatic.com https://fonts.gstatic.com; manifest-src 'self'; media-src 'none'; object-src 'none'; script-src 'self' https://www.googletagmanager.com https://www.clarity.ms https://www.googleadservices.com https://googleads.g.doubleclick.net https://tagmanager.google.com; script-src-attr 'none'; style-src 'self' https://www.googletagmanager.com https://tagmanager.google.com https://fonts.googleapis.com 'unsafe-inline'; style-src-attr 'unsafe-inline'; worker-src 'none'; upgrade-insecure-requests" env=Z2O_GTM_PREVIEW
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), document-domain=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), xr-spatial-tracking=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin" env=!Z2O_GTM_PREVIEW
  Header always set Cross-Origin-Opener-Policy "unsafe-none" env=Z2O_GTM_PREVIEW
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Origin-Agent-Cluster "?1"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set X-XSS-Protection "0"
</IfModule>
